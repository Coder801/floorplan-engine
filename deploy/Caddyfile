:{$PORT}

encode gzip
handle /api/* {
	reverse_proxy 127.0.0.1:8000
}
handle {
	# Файлы сборки с хешем в имени не меняются — кэш надолго; index.html и version.json —
	# всегда свежие, иначе вкладка не узнает о новой выкладке (web/src/version.ts)
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/*
	header @fresh Cache-Control "no-cache"
	root * /srv/web
	try_files {path} /index.html
	file_server
}
