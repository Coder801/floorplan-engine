# Локальная база для разработки (docker-compose.yml). Скопируйте в .env.
POSTGRES_USER=floorplan_engine
POSTGRES_PASSWORD=floorplan_engine
POSTGRES_DB=floorplan_engine
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://floorplan_engine:floorplan_engine@localhost:5433/floorplan_engine

# Вход в просмотр (service/auth.py). Без SHTROBA_AUTH=on просмотр открыт, как раньше.
# SHTROBA_AUTH=on
# SHTROBA_SECRET=<длинная случайная строка, от 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))">
# SHTROBA_PUBLIC_URL=http://127.0.0.1:5173
# Адрес возврата в Google Cloud Console: <SHTROBA_PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SHTROBA_SUPERUSERS=you@example.com
# SHTROBA_DEV_LOGIN=1     # «Зайти для разработки» — под первым SHTROBA_SUPERUSERS; только http (локально)
# Вход по коду на почту (service/api/mail.py): без SMTP_HOST локально код — в терминале сервера
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587            # 465 — SSL
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Штроба <login@example.com>
# SHTROBA_VISITOR=1        # гостевой вход для отладки; в окружении Railway «production» запрещён
