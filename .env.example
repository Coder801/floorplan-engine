# Local development database (docker-compose.yml). Copy to .env.
POSTGRES_USER=floorplan_engine
POSTGRES_PASSWORD=floorplan_engine
POSTGRES_DB=floorplan_engine
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://floorplan_engine:floorplan_engine@localhost:5433/floorplan_engine

# Viewer login (service/auth.py). Without SHTROBA_AUTH=on the viewer is open, as before.
# SHTROBA_AUTH=on
# SHTROBA_SECRET=<a long random string, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))">
# SHTROBA_PUBLIC_URL=http://127.0.0.1:5173
# Redirect URL in Google Cloud Console: <SHTROBA_PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=      # @BotFather bot for phone login; locally the server polls the Bot API itself, over https it sets a webhook
# SHTROBA_SUPERUSERS=you@example.com,+380501234567   # e-mail or phone (as in Telegram, "+380…")
# SHTROBA_OWNER=+380501234567     # e-mail or phone: project folders without a database row go to this user's studio when they log in and choose "Firm"
# SHTROBA_DEV_LOGIN=1     # "Log in for development" as the first SHTROBA_SUPERUSERS entry; http only (locally)
# E-mail code login (service/api/mail.py): without SMTP_HOST the code shows in the server terminal locally
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587            # 465 — SSL
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Shtroba <login@example.com>
# SHTROBA_VISITOR=1        # guest login for debugging; forbidden in the Railway "production" environment
# SHTROBA_ACCESS_CODES=vavilovykh-11-216=ABCD-2345   # permanent access codes "folder=CODE", comma-separated: the service writes them to the database on start (tests)

# Проекты в базе (этап Б, docs/database.md, «Переезд проектов из папок в базу»). Без этого просмотр
# берёт проекты из папки, как раньше. С db нужен вход (SHTROBA_AUTH=on) и перенос проектов:
# floorplan-engine project import projects --owner <почта>
# SHTROBA_STORAGE=db
# SHTROBA_OBJECTS=data/objects      # хранилище файлов (исходники, листы, сметы); на сервере — на volume
