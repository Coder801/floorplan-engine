{
  "name": "floorplan-engine-web",
  "private": true,
  "version": "0.4.3",
  "description": "Просмотр собранных проектов Штроба: листы .epd, правка трасс, 3D проводки",
  "type": "module",
  "scripts": {
    "dev": "node scripts/css-types.mjs && vite",
    "build": "node scripts/css-types.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/css-types.mjs && tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/**",
    "css-types": "node scripts/css-types.mjs",
    "prepare": "cd .. && husky web/.husky"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "i18next": "26.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "husky": "^9.1.7",
    "sass-embedded": "1.107.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12"
  }
}
